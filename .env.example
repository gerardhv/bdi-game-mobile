# Reference list of environment variables. Nothing loads this file automatically:
# locally, set values in the terminal before starting; in the cloud, set them in Render and Vercel.
# See docs/local.md and docs/deployment.md.

# --- Game API (Render in the cloud) ---
PORT=8787
# Dev-login is on by default only locally (no NODE_ENV=production, no SUPABASE_URL).
# Online with dev-login: ALLOW_DEV_AUTH=true plus a long random AUTH_SECRET, otherwise the API refuses dev-login.
ALLOW_DEV_AUTH=true
AUTH_SECRET=dev-only-secret-change-me
INTERNAL_TICK_SECRET=dev-tick-secret
# Empty locally. Online: the exact website address, e.g. https://bdi-game-mobile.vercel.app (comma-separated for several).
CORS_ORIGIN=
PRESENTATION_MS=3000
PIPELINE_MS=1000
ANIMATION_MS=4000
GRACE_MS=30000
SESSION_TTL_HOURS=24
# Optional Postgres. With this set, the API stores sessions in the database instead of data/game.json.
# Local Supabase (npx supabase start):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase cloud: Session pooler string plus ?sslmode=no-verify
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=no-verify
# Optional Supabase Auth. When both are set, the API accepts Supabase anonymous sessions.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=

# --- Website (Vercel in the cloud; baked in at build time) ---
# Never put the service-role key in Vite variables.
# VITE_API_URL=https://bdi-game-api.onrender.com
# Only needed when QR codes must point to a different address than the one the beamer opens.
# VITE_PUBLIC_BASE_URL=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Local only: enables #/bootstrap. Never set in Vercel.
# VITE_ALLOW_DEV_AUTH=true
